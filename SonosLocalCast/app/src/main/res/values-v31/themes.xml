<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ 的启动画面（SplashScreen）单独走一套属性，不再只认 windowBackground。
      不显式指定时，各家 ROM（尤其 HyperOS）会用系统默认的浅色，于是冷启动会闪一张白卡片。

      App 是纯黑界面，这里把启动画面也压成纯黑，视觉上"直接从黑到黑"。
      注意：adaptive icon 的背景层（@color/ic_launcher_background = 白）仍会被部分 ROM
      采样来做启动动画底色 —— 若仍见白，需要把图标底色也改深色。
    -->
    <style name="Theme.SonosLocalCast" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
