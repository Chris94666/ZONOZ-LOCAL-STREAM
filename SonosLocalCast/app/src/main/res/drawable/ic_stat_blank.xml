<?xml version="1.0" encoding="utf-8"?>
<!--
  通知的 small icon。

  用完全透明的图形是有意为之：Android 13+ 的媒体通知会把这个 small icon 叠在
  专辑图右下角，大小/位置由系统决定、无法调整。我们要自己画 ZONOZ 角标
  （见 core/NotifArt.kt），所以先把系统那层隐藏掉，避免两个角标同时出现。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <size
        android:width="24dp"
        android:height="24dp" />
</shape>
